{
  "permissions": {
    "allow": [
      "mcp__plugin_oh-my-claudecode_t__state_read",
      "mcp__plugin_oh-my-claudecode_t__state_list_active",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "command": "bash .claude/hooks/validate-azimuth.sh",
            "timeout": 10,
            "statusMessage": "AZIMUTH validation gate..."
          }
        ]
      }
    ]
  }
}
